<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#0F172A">
    <Spinner android:id="@+id/spinnerLogin" android:layout_width="match_parent" android:layout_height="56dp" android:background="#1E293B"/>
    <ProgressBar android:id="@+id/progressLogin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
    <TextView android:id="@+id/tvLoginInfo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cargando..." android:textColor="#94A3B8" android:layout_marginTop="8dp" android:layout_marginBottom="24dp"/>
    <Button android:id="@+id/btnIniciarSesion" android:layout_width="match_parent" android:layout_height="56dp" android:text="INICIAR SESION"/>
</LinearLayout>
