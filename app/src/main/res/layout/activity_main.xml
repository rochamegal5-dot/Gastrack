<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#0F172A">
    <TextView android:id="@+id/tvBienvenido" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hola" android:textSize="22sp" android:textColor="#FFFFFF" android:textStyle="bold"/>
    <TextView android:id="@+id/tvEquipo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Equipo" android:textColor="#FACC15" android:layout_marginBottom="32dp"/>
    <Button android:id="@+id/btnIniciar" android:layout_width="match_parent" android:layout_height="56dp" android:text="INICIAR" android:layout_marginBottom="12dp"/>
    <Button android:id="@+id/btnDetener" android:layout_width="match_parent" android:layout_height="56dp" android:text="PAUSAR" android:layout_marginBottom="24dp"/>
    <Button android:id="@+id/btnCerrarSesion" android:layout_width="match_parent" android:layout_height="56dp" android:text="CERRAR SESION"/>
</LinearLayout>
